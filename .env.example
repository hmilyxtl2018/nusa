# Server only — never prefix with VITE_.
XAI_API_KEY=

# Keep accounts off until you add sign-in on purpose.
VITE_AUTH_ENABLED=false

# Optional cost / latency knobs (all optional; unset = defaults below).
# Vision detail for two-phase analyze: auto | low | high
# NUSA_VISION_DETAIL_PASS_A=auto
# NUSA_VISION_DETAIL_PASS_B=high
# Models (fallback to grok-4.6 on 400/404 of the primary)
# NUSA_MODEL_PASS_A=grok-4.5
# NUSA_MODEL_PASS_B=grok-4.5
# NUSA_MODEL_ASK=grok-4.5
# NUSA_MODEL_FALLBACK=grok-4.6
